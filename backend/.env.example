NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=eduswap

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@eduswap.local
SEED_ADMIN_PASSWORD=ChangeMe123
SEED_STUDENT_PASSWORD=Student123

# Optional overrides (defaults: 10 login attempts / 15 min, 20 sign-ups / hour per IP)
# LOGIN_MAX_ATTEMPTS=10
# REGISTER_MAX_PER_HOUR=20

# Set to 1 when running behind Nginx or another reverse proxy (production)
# TRUST_PROXY=1
